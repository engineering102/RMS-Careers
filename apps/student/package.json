{
  "name": "@rms/student",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "student:seed": "tsx scripts/seed-student.ts --target=development",
    "cf:build": "node ../../scripts/check-cloudflare-build-env.mjs pre && opennextjs-cloudflare build && node ../../scripts/check-cloudflare-build-env.mjs post",
    "preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "deploy": "pnpm cf:build && opennextjs-cloudflare deploy",
    "test:int": "vitest run -c vitest.int.config.ts",
    "student:seed:test": "tsx scripts/seed-student.ts --target=test",
    "student:verify-seed": "tsx scripts/verify-seed.ts --target=development",
    "student:verify-seed:test": "tsx scripts/verify-seed.ts --target=test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.5",
    "@opennextjs/cloudflare": "^1.20.8",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@rms/auth": "workspace:*",
    "@rms/db": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.31.4",
    "lucide-react": "^0.400.0",
    "next": "^15.1.9",
    "next-auth": "5.0.0-beta.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vitest": "2.0.0",
    "wrangler": "^4.147.0"
  }
}
