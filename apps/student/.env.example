# Isolated Auth.js secret for student.rms-careers.com. Never reuse Admin/Tutor secrets.
AUTH_SECRET=""
# NOTE (Slice 0): in .env.local this must be a DEVELOPMENT database (name starting "rms_dev"), not production.
#   Seeds (--target=development) reject anything else. Tests never read this file; they use TEST_DATABASE_URL
#   (see repo-root .env.example and docs/development/testing.md).
POSTGRES_URL=""


#
# Optional email delivery (Resend). Without RESEND_API_KEY, reset/activation emails are skipped and logged.
RESEND_API_KEY=""
EMAIL_FROM=
# Base URL used in emailed links. Local default (when unset): http://localhost:3002
# Production (Cloudflare): https://student.rms-careers.com (set in wrangler.jsonc vars)
STUDENT_APP_URL=
