{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "rms-admin",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-10-04",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    // Smart Placement: run the Worker near the database rather than at the visitor's PoP, so each sequential
    // Neon round-trip stays short (see apps/student/wrangler.jsonc).
    "placement": { "mode": "smart" },
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "routes": [
        {
            "pattern": "admin.rms-careers.com",
            "custom_domain": true
        }
    ],
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "rms-admin"
        }
    ],
    // Workers Paid. Admin hashes with bcryptjs (12 rounds, ~350 ms CPU each): admin login, and one
    // placeholder hash per NEW student in bulk enrollment import (sequential, one request).
    // 300000 ms is the Paid-plan maximum; lower it once import volume is known.
    "limits": {
        "cpu_ms": 300000
    },
    // Non-secret configuration.
    "vars": {
        "STUDENT_APP_URL": "https://student.rms-careers.com",
        // Tutor invitation links (lib/email/tutor-portal-url.ts). Set at the tutor launch, after rms-tutor was deployed
        // and verified (docs/development/tutor-launch.md step 6); without it admin sends no tutor invitations.
        "TUTOR_APP_URL": "https://tutor.rms-careers.com",
        "EMAIL_LOGO_URL": "https://www.rms-careers.com/rms-logo.jpg"
    },
    // Cloudflare Workers Rate Limiting (audit F-04). Read by lib/security/request-limits.ts; keep limit/period
    // equal to the in-code fallback rules. namespace_id must be unique per binding within the Cloudflare account.
    "ratelimits": [
        // Audit PR-08: strict per account, per client IP (see enforceAuthLimits).
        { "name": "AUTH_ACCOUNT_RATE_LIMITER", "namespace_id": "1201", "simple": { "limit": 5, "period": 60 } },
        { "name": "AUTH_CLIENT_RATE_LIMITER", "namespace_id": "1203", "simple": { "limit": 60, "period": 60 } },
        { "name": "PUBLIC_FORM_RATE_LIMITER", "namespace_id": "1202", "simple": { "limit": 5, "period": 60 } }
    ],
    // Secrets are never committed. Set with `wrangler secret put <NAME>` (or the dashboard).
    // RESEND_API_KEY and EMAIL_FROM are required (audit F-19): without them activation, recovery and
    // enrollment emails are silently skipped and new students cannot onboard.
    "secrets": {
        "required": ["POSTGRES_URL", "AUTH_SECRET", "AUTH_GITHUB_ID", "AUTH_GITHUB_SECRET", "RESEND_API_KEY", "EMAIL_FROM"]
    },
    "observability": {
        "enabled": true
    }
}
