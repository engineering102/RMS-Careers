{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["components/*"],
      "@/lib/*": ["lib/*"],
      "@rms/db/schema": ["../../packages/db/src/schema"],
      "@rms/db/tx": ["../../packages/db/src/tx"],
      "@rms/db/xp-ledger": ["../../packages/db/src/xp-ledger"],
      "@rms/db/guard-env": ["../../packages/db/src/guard-env"],
      "@rms/db/migration-runner": ["../../packages/db/src/migration-runner"],
      "@rms/db/node-tooling": ["../../packages/db/src/node-tooling"],
      "@rms/academic/scope": ["../../packages/academic/src/scope"],
      "@rms/academic/projects": ["../../packages/academic/src/projects"],
      "@rms/academic/assessments": ["../../packages/academic/src/assessments"],
      "@rms/academic/review": ["../../packages/academic/src/review"],
      "@rms/academic/review-rules": ["../../packages/academic/src/review-rules"],
      "@rms/academic/notifications": ["../../packages/academic/src/notifications"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
