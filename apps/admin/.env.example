# ---------------------------------------------------------------------------------------------
# Local development: copy to apps/admin/.env.local (gitignored) and fill in. `pnpm dev:admin`.
# Cloudflare preview (`pnpm --filter @rms/admin preview`): put secrets in apps/admin/.dev.vars
#   (gitignored; template: .dev.vars.example).
# Cloudflare production: secrets via `wrangler secret put <NAME>`; non-secret vars live in
#   wrangler.jsonc. NEVER commit real values.
#
# WARNING: OpenNext inlines .env / .env.local into .open-next/cloudflare/next-env.mjs at build time.
#   Run the deploy build from a checkout with NO .env.local, or secrets end up inside the Worker bundle.
#   Do not set NEXTAUTH_URL / AUTH_URL there either: Auth.js would pin every redirect and the
#   GitHub callback to that origin. The app uses trustHost and derives the origin from the request.
# ---------------------------------------------------------------------------------------------

# Database (Neon PostgreSQL) - secret
POSTGRES_URL=

# Authentication (Auth.js) - secrets. Generate AUTH_SECRET with: openssl rand -base64 32
# Must be unique to Admin; never share with Student/Tutor.
AUTH_SECRET=

# GitHub OAuth - secrets. Callback URLs:
#   local:      http://localhost:3000/api/auth/callback/github
#   production: https://admin.rms-careers.com/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email (Resend) - optional. Without RESEND_API_KEY emails are skipped (provider_not_configured).
RESEND_API_KEY=
EMAIL_FROM=RMS Careers <noreply@rms-careers.com>
# Public HTTPS URL of the RMS logo for email headers (not secret).
# Production (set in wrangler.jsonc): https://www.rms-careers.com/rms-logo.jpg
# Leave blank locally; the email header uses a text fallback.
EMAIL_LOGO_URL=
# Base URL used in emailed activation links (not secret).
# Local default (when unset): http://localhost:3002. Production (wrangler.jsonc): https://student.rms-careers.com
STUDENT_APP_URL=

# One-time bootstrap for `pnpm admin:seed` only (never needed by the running app)
ADMIN_INITIAL_EMAIL="admin@rms-careers.com"
ADMIN_INITIAL_PASSWORD="your-secure-password"
ADMIN_INITIAL_NAME="Admin Name"
