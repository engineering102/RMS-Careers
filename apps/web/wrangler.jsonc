{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "rms-web",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-10-04",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "routes": [
        {
            "pattern": "www.rms-careers.com",
            "custom_domain": true
        }
    ],
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "rms-web"
        }
    ],
    // Cloudflare Workers Rate Limiting (audit F-04). Read by lib/security/request-limits.ts; keep limit/period
    // equal to the in-code fallback rules. namespace_id must be unique per binding within the Cloudflare account.
    "ratelimits": [
        { "name": "PUBLIC_FORM_RATE_LIMITER", "namespace_id": "1101", "simple": { "limit": 5, "period": 60 } }
    ],
    // Partner enquiry delivery (lib/partner-enquiry): RESEND_API_KEY, EMAIL_FROM and the recipient PARTNER_ENQUIRY_TO.
    "secrets": {
        "required": ["POSTGRES_URL", "RESEND_API_KEY", "EMAIL_FROM", "PARTNER_ENQUIRY_TO"]
    },
    "observability": {
        "enabled": true
    }
}
