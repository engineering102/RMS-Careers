# Isolated Auth.js secret for tutor.rms-careers.com. Never reuse the Admin or Student secret.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# In .env.local this must be a DEVELOPMENT database (name starting "rms_dev"), never production.
# Tests never read this file; they use TEST_DATABASE_URL (see docs/development/testing.md).
POSTGRES_URL=""

# Optional email delivery (Resend). Without RESEND_API_KEY, activation/reset emails are skipped and logged.
RESEND_API_KEY=""
EMAIL_FROM=
# Base URL used in emailed links. Local default (when unset): http://localhost:3003
# Production: https://tutor.rms-careers.com (set in wrangler.jsonc vars)
TUTOR_APP_URL=
