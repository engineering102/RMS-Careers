# Copy to tests/load/.env.load.local (git-ignored) and fill in. Placeholders only: never commit real values.
# Use with:  node --env-file=tests/load/.env.load.local tests/load/run.mjs --scenario=<name> --profile=<name>

# --- Targets (origins only, no path). Plain http is accepted only for loopback (local workerd / next start). ---
# A NON-PRODUCTION deployment whose database is the NonProd test branch. Production hosts (*.rms-careers.com) are
# refused, except the public-web smoke (<= 5 VUs) with LOAD_ALLOW_PRODUCTION below.
WEB_BASE_URL=http://127.0.0.1:8790
STUDENT_BASE_URL=http://127.0.0.1:8791
ADMIN_BASE_URL=http://127.0.0.1:8792

# --- Synthetic accounts (created by: pnpm --filter @rms/student load:seed:test -- --count=<N>) ---
# Must equal the password the seeder used. At least 12 characters; not the demo password.
LOAD_TEST_STUDENT_PASSWORD=<generate-a-long-random-value>
# Optional: defaults to tests/load/fixtures/students.local.json
# LOAD_FIXTURE=tests/load/fixtures/students.local.json

# --- Admin read scenario: an admin that exists ONLY in the test database ---
LOAD_ADMIN_USERNAME=<test-admin-email>
LOAD_ADMIN_PASSWORD=<test-admin-password>

# --- Write scenarios (practice-quiz, formal-assessment): non-production only ---
# LOAD_ALLOW_WRITES=1
# Server Action ids from the SAME build the target runs:
#   node tests/load/scripts/extract-action-ids.mjs apps/student/.open-next --out=tests/load/fixtures/action-ids.local.json
# LOAD_ACTION_IDS=tests/load/fixtures/action-ids.local.json

# --- Shape overrides (optional) ---
# LOAD_VUS=50            peak virtual users for a single-profile run (ignored by --staged)
# LOAD_RAMP=2m           ramp-up duration
# LOAD_HOLD=5m           steady-state duration
# LOAD_THINK_MIN_S=5     think time between pages (seconds)
# LOAD_THINK_MAX_S=20
# LOAD_BURST_WINDOW_S=180  window for auth-burst / formal-assessment arrivals
# K6_BIN=k6

# --- Production (public website only, read-only, smoke profile, <= 5 VUs). Leave unset unless the owner approved. ---
# LOAD_ALLOW_PRODUCTION=read-only-public-smoke
