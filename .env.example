# ---------------------------------------------------------------------------------------------
# Repo-root environment template. Real values go in untracked files (.env* is git-ignored).
# See docs/development/testing.md for the full database separation model.
#
#   development app   -> apps/<app>/.env.local           (POSTGRES_URL = a rms_dev* database)
#   tests (integration)-> TEST_DATABASE_URL below         (RMS-Careers-NonProd / test branch, never .env.local)
#   production        -> Cloudflare secrets / wrangler    (never a developer machine or CI)
# ---------------------------------------------------------------------------------------------

# Dedicated TEST database: the `test` branch of the separate Neon project RMS-Careers-NonProd.
# Its database is also called "neondb", so the NAME is never trusted; identity is the Neon endpoint.
# Put both values in the shell, CI secrets, or an untracked <repo>/.env.test.local. Tests read ONLY these.
TEST_DATABASE_URL=
# Non-secret pin: the Neon endpoint id (the "ep-xxxx" part of the TEST_DATABASE_URL host, without
# "-pooler"). The guard refuses any URL whose endpoint differs from this pin.
TEST_DATABASE_ENDPOINT=

# Optional: extra production endpoints (comma-separated hosts) that every guard must reject
# regardless of database name.
RMS_PRODUCTION_DB_HOSTS=
